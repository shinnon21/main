---
import type { TermRef } from "../lib/queries.ts";
import { hrefFor } from "../lib/format.ts";
import { l } from "../lib/lang.ts";
import { termName } from "../lib/l10n.ts";
import type { Lang } from "../lib/i18n.ts";
interface Props { terms: TermRef[]; limit?: number; linked?: boolean; lang?: Lang }
const { terms, limit = 3, linked = true, lang = Astro.locals.lang ?? "ja" } = Astro.props;
const skills = terms.filter((t) => t.taxonomy === "skill").slice(0, limit);
---
{skills.length > 0 && (
  <div class="tags">
    {skills.map((t) => linked
      ? <a class="chip" href={l(lang, hrefFor("skill", t.slug))}># {termName(lang, t.name)}</a>
      : <span class="chip"># {termName(lang, t.name)}</span>)}
  </div>
)}
