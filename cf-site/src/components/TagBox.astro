---
import type { TermRef } from "../lib/queries.ts";
import { hrefFor } from "../lib/format.ts";
import { t, type Lang } from "../lib/i18n.ts";
import { l } from "../lib/lang.ts";
import { termName } from "../lib/l10n.ts";
interface Props { skills: TermRef[]; lang?: Lang }
const { skills, lang = Astro.locals.lang ?? "ja" } = Astro.props;
---
{skills.length > 0 && (
  <div class="side-box">
    <div class="sb-head"><span class="lbl">tags</span><h3>{t(lang, "タグから探す", "Browse by tag")}</h3></div>
    {skills.map((s) => <a class="chip" href={l(lang, hrefFor("skill", s.slug))}># {termName(lang, s.name)}</a>)}
  </div>
)}
