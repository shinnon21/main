---
import Layout from "./Layout.astro";
import PageHero from "./PageHero.astro";
import type { getPostBySlug } from "../lib/posts.ts";
import { autop, docTitle } from "../lib/format.ts";
import type { Lang } from "../lib/i18n.ts";
type Post = NonNullable<Awaited<ReturnType<typeof getPostBySlug>>>;
interface Props { post: Post; lang?: Lang }
const { post, lang = "ja" } = Astro.props;
---
<Layout title={docTitle(post.title)} lang={lang}>
  <PageHero label={post.slug} title={post.title} crumbs={[{ label: post.title }]} />
  <div class="sec">
    <div class="container" style="max-width:820px">
      <article class="entry-wrap" style="max-width:none">
        <div class="entry-content" set:html={autop(post.content ?? "")} />
      </article>
    </div>
  </div>
</Layout>
