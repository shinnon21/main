---
import { getEnv } from "../lib/env.ts";
import { resolveSns } from "../lib/sns-data.ts";
interface Props { style?: "pill" | "icons" | "tiles" }
const { style = "pill" } = Astro.props;
const iconsOnly = style === "icons";
// 同一ページに複数回出力してもSVGグラデーションのidが衝突しないよう連番化
const g = globalThis as unknown as { __kbIg?: number };
g.__kbIg = (g.__kbIg ?? 0) + 1;
const uid = g.__kbIg;
const items = (await resolveSns(getEnv().DB)).map((s) => ({ ...s, svg: s.svg.replaceAll("kbIgGrad", `kbIgGrad${uid}`) }));
---
{items.length > 0 && (
  <div class={`sns-row${iconsOnly ? " sns-icons" : style === "tiles" ? " sns-tiles" : ""}`}>
    {items.map((s) => (
      <a class="sns-btn" href={s.url} target="_blank" rel="noopener" aria-label={iconsOnly ? s.label : undefined}>
        <Fragment set:html={s.svg} />
        {!iconsOnly && <span>{s.label}</span>}
      </a>
    ))}
  </div>
)}
