---
import "../styles/global.css";
import "../styles/refresh.css";
import SnsLinks from "./SnsLinks.astro";
import { ADSENSE_CLIENT, GA_ID, gaSnippet, trackingEnabled } from "../lib/tracking.ts";
import { getEnv } from "../lib/env.ts";
import LangSwitch from "./LangSwitch.astro";
import { t, type Lang } from "../lib/i18n.ts";
import { altPair, l } from "../lib/lang.ts";
import { SITE_URL } from "../lib/format.ts";
import { canonicalUrl, metaDescription } from "../lib/seo.ts";

interface Seo { type?: "website" | "article"; image?: { url: string; isDefault: boolean }; jsonld?: Record<string, unknown>[]; path?: string }
interface Props { title: string; description?: string; lang?: Lang; bodyClass?: string; pair?: boolean; seo?: Seo; noindex?: boolean }
const { title, bodyClass = "", pair = true, seo = {}, noindex = false } = Astro.props;
const lang: Lang = Astro.props.lang ?? Astro.locals.lang ?? "ja";
const alt = pair ? altPair(Astro.locals.path ?? "/") : { ja: "/", en: "/en/" };

const db = getEnv().DB;
const setting = async (key: string, fallback: string) => {
  const r = await db.prepare("SELECT value FROM settings WHERE key=?").bind(key).first<{ value: string }>();
  try { return r ? (JSON.parse(r.value) as string) || fallback : fallback; } catch { return fallback; }
};
const siteNameJa = await setting("blogname", "小林慎之助");
const siteDescJa = await setting("blogdescription", "構想を、社会に実装する。");
const siteName = t(lang, siteNameJa, "Shinnosuke Kobayashi");
const siteDesc = siteDescJa;
const description = Astro.props.description ?? metaDescription({ lang, kind: "site", siteDescription: siteDescJa });
const canonical = pair ? canonicalUrl(l(lang, seo.path ?? Astro.locals.path ?? "/")) : null;
const og = seo.image ?? { url: `${SITE_URL}/assets/img/og-default.png`, isDefault: true };
const ld = seo.jsonld?.length ? JSON.stringify({ "@context": "https://schema.org", "@graph": seo.jsonld }).replace(/</g, "\\u003c") : null;

const nav: [string, string, string][] = [
  [t(lang, "実績", "Works"), t(lang, "works", "実績"), l(lang, "/works/")],
  [t(lang, "コラム", "Column"), t(lang, "column", "コラム"), l(lang, "/column/")],
  [t(lang, "お知らせ", "News"), t(lang, "news", "お知らせ"), l(lang, "/news/")],
  [t(lang, "AIチャット", "AI Chat"), "chat", l(lang, "/chat/")],
  [t(lang, "プロフィール", "Profile"), t(lang, "profile", "プロフィール"), l(lang, "/profile/")],
  ["About", t(lang, "about", "このサイトについて"), l(lang, "/about/")],
];
const year = new Date().getFullYear();
const tracking = trackingEnabled(Astro.url.host);
const searchSvg = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#5C5C5C" stroke-width="2.4"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>';
---
<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {tracking && <script async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE_CLIENT}`} crossorigin="anonymous" is:inline></script>}
  {tracking && <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`} is:inline></script>}
  {tracking && <script is:inline set:html={gaSnippet()} />}
  <link rel="alternate" type="application/rss+xml" title={siteNameJa} href="/feed/" />
  {noindex && <meta name="robots" content="noindex,follow" />}
  {canonical && <link rel="canonical" href={canonical} />}
  {canonical && (
    <>
      <meta property="og:site_name" content={t(lang, siteNameJa, "Shinnosuke Kobayashi Official Website")} />
      <meta property="og:title" content={title} />
      <meta property="og:type" content={seo.type ?? "website"} />
      <meta property="og:url" content={canonical} />
      <meta property="og:description" content={description} />
      <meta property="og:image" content={og.url} />
      {og.isDefault && <meta property="og:image:width" content="1200" />}
      {og.isDefault && <meta property="og:image:height" content="630" />}
      <meta property="og:locale" content={lang === "en" ? "en_US" : "ja_JP"} />
      <meta name="twitter:card" content="summary_large_image" />
    </>
  )}
  {ld && <script type="application/ld+json" set:html={ld} />}
  {pair && <link rel="alternate" hreflang="ja" href={SITE_URL + alt.ja} />}
  {pair && <link rel="alternate" hreflang="en" href={SITE_URL + alt.en} />}
  {pair && <link rel="alternate" hreflang="x-default" href={SITE_URL + alt.ja} />}
  <link rel="icon" href="/assets/img/favicon-32.png" sizes="32x32" />
  <link rel="icon" href="/assets/img/favicon-192.png" sizes="192x192" />
  <link rel="apple-touch-icon" href="/assets/img/apple-touch-icon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800&family=Noto+Sans+JP:wght@400;500;700;900&display=swap" />
</head>
<body class={bodyClass}>

<header class="site">
  <div class="container">
    <a class="logo" href={l(lang, "/")}>
      <img class="logo-img" src="/assets/img/logo-horizontal.svg" alt={siteName} width="575" height="58" />
    </a>

    <nav class="gnav" id="gnav">
      <ul>
        {nav.map(([label, small, href]) => <li><a href={href}>{label}<small>{small}</small></a></li>)}
      </ul>
      <div class="gnav-extra">
        <LangSwitch lang={lang} ja={alt.ja} en={alt.en} />
        <form class="search" role="search" method="get" action={l(lang, "/")}>
          <button type="submit" aria-label="検索" set:html={searchSvg} />
          <input type="text" name="s" value="" placeholder={t(lang, "フリーワードで検索", "Search")} />
        </form>
        <SnsLinks />
        <a class="btn primary" href={l(lang, "/contact/")}>{t(lang, "お問い合わせ →", "Contact →")}</a>
      </div>
    </nav>

    <div class="h-right">
      <form class="search" role="search" method="get" action={l(lang, "/")}>
        <button type="submit" aria-label="検索" set:html={searchSvg} />
        <input type="text" name="s" value="" placeholder={t(lang, "フリーワードで検索", "Search")} />
      </form>
      <button class="menu-btn" id="menuBtn" aria-label="メニュー" aria-controls="gnav" aria-expanded="false"><span></span><span></span><span></span></button>
    </div>
  </div>
</header>

<slot />

<footer class="site-footer">
  <div class="container">
    <div class="top">
      <div class="f-logo">
        <span class="jp">{siteName}</span>
        <span class="sub">shinnosuke-kobayashi.jp</span>
        <p>{t(lang, siteDesc, "From political and governmental DX to pharmaceutical supply chain research — the official website of Shinnosuke Kobayashi, an aspiring coordinator who delivers Japanese technology to society.")}</p>
        <SnsLinks style="icons" />
      </div>
      <div>
        <h4>sitemap</h4>
        <ul class="links">
          <li><a href={l(lang, "/works/")}>{t(lang, "実績", "Works")}</a></li>
          <li><a href={l(lang, "/column/")}>{t(lang, "コラム", "Column")}</a></li>
          <li><a href={l(lang, "/news/")}>{t(lang, "お知らせ", "News")}</a></li>
          <li><a href={l(lang, "/profile/")}>{t(lang, "プロフィール", "Profile")}</a></li>
          <li><a href={l(lang, "/searches/")}>{t(lang, "条件から探す", "Advanced search")}</a></li>
        </ul>
      </div>
      <div>
        <h4>links</h4>
        <ul class="links">
          <li><a href={l(lang, "/chat/")}>{t(lang, "AIチャット", "AI Chat")}</a></li>
          <li><a href={l(lang, "/contact/")}>{t(lang, "お問い合わせ", "Contact")}</a></li>
          <li><a href={l(lang, "/about/")}>{t(lang, "About（このサイトについて）", "About this site")}</a></li>
          <li><a href={l(lang, "/privacy/")}>{t(lang, "プライバシーポリシー", "Privacy Policy")}</a></li>
          <li><a href="https://www.weeave.co.jp/" target="_blank" rel="noopener">{t(lang, "Weeave株式会社 ↗", "Weeave Inc. ↗")}</a></li>
        </ul>
      </div>
    </div>
    <div class="bottom">
      <span class="en">© {year} Shinnosuke Kobayashi</span>
      <LangSwitch lang={lang} ja={alt.ja} en={alt.en} />
    </div>
  </div>
</footer>
<script src="/assets/main.js" defer></script>
</body>
</html>
