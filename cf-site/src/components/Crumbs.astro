---
interface Props { items: { label: string; href?: string }[] }
const { items } = Astro.props;
---
<nav class="breadcrumbs" aria-label="パンくず"><a href="/">top</a>{items.map((c) => <Fragment><span class="sep">›</span>{c.href ? <a href={c.href}>{c.label}</a> : <span>{c.label}</span>}</Fragment>)}</nav>
