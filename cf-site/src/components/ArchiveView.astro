---
import Layout from "./Layout.astro";
import PageHero from "./PageHero.astro";
import WorksCard from "./WorksCard.astro";
import ColumnCard from "./ColumnCard.astro";
import Pagination from "./Pagination.astro";
import SideRanking from "./SideRanking.astro";
import TagBox from "./TagBox.astro";
import { getEnv } from "../lib/env.ts";
import { allSkills, ranking, topSkills, type CardPost } from "../lib/queries.ts";
import { docTitle, formatDate, hrefFor } from "../lib/format.ts";
import { t, type Lang } from "../lib/i18n.ts";

interface Props {
  type: "works" | "column" | "news";
  data: { posts: CardPost[]; total: number; pages: number };
  page: number;
  basePath: string;
  title: string;
  crumbs: { label: string; href?: string }[];
  lang?: Lang;
}
const { type, data, page, basePath, title, crumbs, lang = "ja" } = Astro.props;
const db = getEnv().DB;
const [rank, skills12, skillsAll] = type === "news" ? [[], [], []] : await Promise.all([ranking(db, 5), topSkills(db, 12), allSkills(db)]);
const badge = (p: CardPost) => p.terms.find((x) => x.taxonomy === "news_type")?.name;
const empty = { works: t(lang, "該当する実績はまだありません。", "No works found yet."), column: t(lang, "コラムはまだありません。", "No columns yet."), news: t(lang, "お知らせはまだありません。", "No news yet.") }[type];
const docName = page > 1 ? `${title}（${page}ページ目）` : title;
---
<Layout title={docTitle(docName)} lang={lang}>
  <PageHero label={type} title={title} crumbs={crumbs} />
  <div class="sec">
    {type === "news" ? (
      <div class="container" style="max-width:820px">
        {data.posts.length > 0 ? (
          <>
            <div class="news-list">
              {data.posts.map((n) => (
                <a class="news-item" href={hrefFor("news", n.slug)}>
                  <span class="d">{formatDate(n.published_at)}</span>
                  {badge(n) && <span class="badge">{badge(n)}</span>}
                  <span class="t">{n.title}</span>
                </a>
              ))}
            </div>
            <Pagination basePath={basePath} current={page} total={data.pages} />
          </>
        ) : <p>{empty}</p>}
      </div>
    ) : (
      <div class="container">
        {type === "works" && skills12.length > 0 && (
          <div class="filter-box" style="padding:22px 28px">
            <form method="get" action="/searches/">
              <input type="hidden" name="types[]" value="works" />
              {skills12.map((s) => <label class="check-pill"><input type="checkbox" name="skills[]" value={s.slug} /># {s.name}</label>)}
              <div class="filter-actions" style="margin-top:12px">
                <button type="submit" class="btn primary sm">{t(lang, "条件から実績を探す", "Search works by criteria")}</button>
                <a class="btn ghost sm" href="/works/">{t(lang, "条件をリセット", "Reset")}</a>
              </div>
            </form>
          </div>
        )}
        <div class="col-wrap">
          <div>
            {data.posts.length > 0 ? (
              <>
                {type === "works"
                  ? <div class="grid2">{data.posts.map((p) => <WorksCard post={p} lang={lang} />)}</div>
                  : data.posts.map((p) => <ColumnCard post={p} lang={lang} />)}
                <Pagination basePath={basePath} current={page} total={data.pages} />
              </>
            ) : <p>{empty}</p>}
          </div>
          <aside>
            <SideRanking items={rank} lang={lang} />
            {type === "works" ? <TagBox skills={skillsAll} lang={lang} /> : (
              <div class="side-box">
                <div class="sb-head"><span class="lbl">search</span><h3>{t(lang, "条件から探す", "Advanced search")}</h3></div>
                <p style="font-size:12.5px;color:var(--gray);margin-bottom:14px">{t(lang, "期間・種別・タグを組み合わせて記事を検索できます。", "Search articles by period, type, and tags.")}</p>
                <a class="btn ghost sm" href="/searches/">{t(lang, "条件検索へ →", "Open search →")}</a>
              </div>
            )}
          </aside>
        </div>
      </div>
    )}
  </div>
</Layout>
