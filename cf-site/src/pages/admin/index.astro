---
import AdminLayout from "../../admin/AdminLayout.astro";
import { getEnv } from "../../lib/env.ts";
import { listAdminPosts } from "../../admin/store.ts";
const db = getEnv().DB;
const counts = (await db.prepare("SELECT type,status,COUNT(*) c FROM posts GROUP BY type,status").bind().all<{ type: string; status: string; c: number }>()).results;
const recent = await listAdminPosts(db, {}, 10);
const types: [string, string][] = [["works", "実績"], ["column", "コラム"], ["news", "お知らせ"], ["page", "固定ページ"]];
const n = (t: string, s: string) => counts.find((x) => x.type === t && x.status === s)?.c ?? 0;
const pub = (r: { type: string; slug: string }) => (r.type === "page" ? `/${encodeURIComponent(r.slug)}/` : `/${r.type}/${encodeURIComponent(r.slug)}/`);
---
<AdminLayout title="ダッシュボード">
  <h1>ダッシュボード</h1>
  <div class="grid">
    {types.map(([t, label]) => (
      <div class="card">
        <strong>{label}</strong>
        <p>公開 {n(t, "publish")} ／ 下書き {n(t, "draft")} ／ ゴミ箱 {n(t, "trash")}</p>
        <a class="btn" href={`/admin/${t}/`}>一覧</a> <a class="btn primary" href={`/admin/${t}/new/`}>新規作成</a>
      </div>
    ))}
  </div>
  <h2>最近の更新</h2>
  <table class="list"><thead><tr><th>タイトル</th><th>種別</th><th>状態</th><th>更新</th></tr></thead><tbody>
    {recent.map((r) => <tr><td><a href={`/admin/${r.type}/${r.id}/`}>{r.title}</a></td><td>{r.type}</td><td><span class={`badge ${r.status}`}>{r.status}</span></td><td>{r.modified_at.slice(0, 16)} UTC</td></tr>)}
  </tbody></table>
</AdminLayout>
