---
import TermArchive from "../../components/TermArchive.astro";
import { getEnv } from "../../lib/env.ts";
import { loadTermPage } from "../../lib/queries.ts";
const r = Astro.params.slug ? await loadTermPage(getEnv().DB, "skill", Astro.params.slug, 1) : null;
if (!r) return Astro.rewrite("/404/");
---
<TermArchive taxonomy="skill" term={r.term} data={r.data} page={1} />
