---
import TermArchive from "../../components/TermArchive.astro";
import { getEnv } from "../../lib/env.ts";
import { listByTerm, termBySlug } from "../../lib/queries.ts";
const db = getEnv().DB;
const term = Astro.params.slug ? await termBySlug(db, "news_type", Astro.params.slug) : null;
if (!term) return Astro.rewrite("/404/");
const data = await listByTerm(db, "news_type", term.slug, 1, 10);
---
<TermArchive taxonomy="news_type" term={term} data={data} />
