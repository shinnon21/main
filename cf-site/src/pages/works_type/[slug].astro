---
import ArchiveView from "../../components/ArchiveView.astro";
import { getEnv } from "../../lib/env.ts";
import { loadTermPage } from "../../lib/queries.ts";
const r = Astro.params.slug ? await loadTermPage(getEnv().DB, "works_type", Astro.params.slug, 1) : null;
if (!r) return Astro.rewrite("/404/");
---
<ArchiveView type="works" data={r.data} page={1} basePath={`/works_type/${encodeURIComponent(r.term.slug)}/`} title={r.term.name} crumbs={[{ label: "実績", href: "/works/" }, { label: r.term.name }]} />
