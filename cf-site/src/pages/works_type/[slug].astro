---
import ArchiveView from "../../components/ArchiveView.astro";
import { getEnv } from "../../lib/env.ts";
import { loadTermPage } from "../../lib/queries.ts";
import { t } from "../../lib/i18n.ts";
import { l } from "../../lib/lang.ts";
import { termName } from "../../lib/l10n.ts";
const lang = Astro.locals.lang ?? "ja";
const r = Astro.params.slug ? await loadTermPage(getEnv().DB, "works_type", Astro.params.slug, 1) : null;
if (!r) return Astro.rewrite("/404/");
---
<ArchiveView type="works" data={r.data} page={1} basePath={l(lang, `/works_type/${encodeURIComponent(r.term.slug)}/`)} title={termName(lang, r.term.name)} crumbs={[{ label: t(lang, "実績", "Works"), href: l(lang, "/works/") }, { label: termName(lang, r.term.name) }]} />
