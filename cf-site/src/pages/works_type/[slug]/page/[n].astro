---
import ArchiveView from "../../../../components/ArchiveView.astro";
import { getEnv } from "../../../../lib/env.ts";
import { loadTermPage } from "../../../../lib/queries.ts";
import { t } from "../../../../lib/i18n.ts";
import { l } from "../../../../lib/lang.ts";
import { termName } from "../../../../lib/l10n.ts";
const lang = Astro.locals.lang ?? "ja";
const { slug, n } = Astro.params;
const page = Number(n);
const r = slug && /^[1-9]\d{0,5}$/.test(n ?? "") ? await loadTermPage(getEnv().DB, "works_type", slug, page) : null;
if (!r) return Astro.rewrite("/404/");
---
<ArchiveView type="works" data={r.data} page={page} basePath={l(lang, `/works_type/${encodeURIComponent(r.term.slug)}/`)} title={termName(lang, r.term.name)} crumbs={[{ label: t(lang, "実績", "Works"), href: l(lang, "/works/") }, { label: termName(lang, r.term.name) }]} />
