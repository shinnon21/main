{
  "name": "kb-site",
  "main": "./src/worker.ts",
  "compatibility_date": "2025-05-21",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "assets": { "directory": "./dist", "binding": "ASSETS" },
  "d1_databases": [
    { "binding": "DB", "database_name": "kb-site", "database_id": "72db141f-e9f7-4aa9-a99f-610743c6cb60", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "kb-media" }],
  "kv_namespaces": [
    { "binding": "CACHE", "id": "cd751868d0984c1d88a0318bbdbd3c81" },
    { "binding": "VIEWS", "id": "5443c9e7e9bd4dd5a77d8ce55bfca865" },
    { "binding": "OAUTH_KV", "id": "405020939f394713b9903e61ef0433b9" }
  ],
  "routes": [
    { "pattern": "shinnosuke-kobayashi.jp", "custom_domain": true },
    { "pattern": "www.shinnosuke-kobayashi.jp", "custom_domain": true }
  ],
  "send_email": [{ "name": "EMAIL" }],
  "vars": { "SITE_ORIGIN": "https://shinnosuke-kobayashi.jp", "ACCESS_TEAM_DOMAIN": "shinnosuke-kobayashi.cloudflareaccess.com", "ACCESS_AUD": "9725fa5d9a5c82cbebcd9a7359842680054c9df871b11999eb1cec615323f660", "ADMIN_EMAILS": "hello@shinnosuke-kobayashi.jp", "TURNSTILE_SITE_KEY": "0x4AAAAAAFXTbIeOVoZJpRrz", "CONTACT_TO": "contact@shinnosuke-kobayashi.jp", "CONTACT_FROM": "noreply@shinnosuke-kobayashi.jp" }
}
